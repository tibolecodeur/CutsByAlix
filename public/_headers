# En-têtes HTTP pour Cloudflare Pages (copié dans le build : dist/_headers).
# Hébergeur retenu : Cloudflare Pages. Rien n'est déployé pour l'instant.
#
# /annuler porte le jeton d'annulation dans le FRAGMENT de l'URL (/annuler#<jeton>) : il n'est
# jamais envoyé au serveur ni recopié dans un Referer. Ces en-têtes sont une protection en plus :
#   · jamais de Referer vers un autre site ;
#   · jamais dans un moteur de recherche.
# La page pose aussi ces consignes dans son HTML (<meta>) : double protection.
/annuler*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex

# Espace admin (et ses fichiers : manifeste, icônes) : jamais dans un moteur de recherche.
# Aucun lien public n'y mène ; les pages posent aussi <meta name="robots" content="noindex">.
/admin*
  X-Robots-Tag: noindex

# Manifeste de la PWA admin, servi avec son type exact.
/admin.webmanifest
  Content-Type: application/manifest+json
