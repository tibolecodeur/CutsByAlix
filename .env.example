# Copie ce fichier en .env.local et remplis les valeurs (Supabase > Project Settings > API).
# .env.local est ignoré par git : ne versionne jamais de vraie valeur.
# Seule la clé "anon" (publique) va ici. Ne mets JAMAIS la clé service_role dans le front.
# Sans ces variables, le site démarre quand même et affiche « Impossible de charger les
# prestations pour le moment ».
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Notifications push à l'admin (ADR 0012) : clé PUBLIQUE VAPID uniquement. La clé privée va dans
# les secrets de l'Edge Function (supabase secrets set), jamais ici. Vide : la carte
# « Notifications » indique que le site n'est pas encore configuré.
VITE_VAPID_PUBLIC_KEY=
